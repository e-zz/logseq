+  "All page generations sharing a name, split into active and recycled."
+  [db page-name]
+  (let [all (->> (entity-util/get-pages-by-name db page-name)
+                 (map #(d/entity db (:e %)))
+                 (remove nil?))
+        {recycled true active false} (group-by recycled-page? all)]
