+         (cond
+           (:error result)
+           (clj->js result)
+
+           (:error readback)
+           (clj->js readback)
+
+           (= "recycled" (:state readback))
+           (clj->js result)
+
+           :else
+           (clj->js {:error "Recycle verification failed: block is not recycled after write"})))
+
+       :else
+       (clj->js {:error (str "Block uuid " uuid-string " cannot be recycled")})))))
